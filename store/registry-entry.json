{
  "name": "tavily",
  "label": "Web Search (Tavily)",
  "description": "Tavily web search, installed at runtime — no rebuild.",
  "icon": "search",
  "version": "1.0.0",
  "author": "TheBananaStand",
  "homepage": "https://github.com/TheBananaStand/leo-tavily",
  "category": "package",
  "mcp": {
    "transport": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "https://github.com/TheBananaStand/leo-tavily/archive/c36dc32c8cc714a99b6e463acd56045c09b1dc02.tar.gz"
    ]
  },
  "descriptor": {
    "provides": [
      "web_search"
    ],
    "fields": [
      {
        "key": "tavily_api_key",
        "label": "API Key",
        "field_type": "password",
        "required": true
      }
    ],
    "entitlements": {
      "settings_read": [
        "tavily_api_key"
      ],
      "network": [
        "api.tavily.com"
      ],
      "sends": [
        {
          "to": "api.tavily.com",
          "classes": [
            "search_queries"
          ],
          "purpose": "The search text and nothing else. Claude writes the query from your conversation, so it can quote what you said — but no transcript, file or account data is attached to it."
        }
      ]
    }
  }
}
